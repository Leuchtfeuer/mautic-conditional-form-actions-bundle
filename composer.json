{
    "name": "leuchtfeuer/mautic-conditional-form-actions-bundle",
    "description": "Enables conditional form submit actions",
    "license": "GPL-3.0",
    "type": "mautic-plugin",
    "homepage": "https://www.Leuchtfeuer.com",
    "authors": [
        {
            "name": "Leuchtfeuer Digital Marketing GmbH",
            "email": "mautic-plugins@Leuchtfeuer.com",
            "homepage": "https://Leuchtfeuer.com/mautic/",
            "role": "Developer"
        }
    ],
    "keywords": ["mautic", "plugin", "integration", "form"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "mautic/core-lib": "^7.0",
        "ext-json": "*"
    },
    "extra": {
        "install-directory-name": "LeuchtfeuerConditionalFormActionsBundle"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.4",
        "symfony/browser-kit": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerConditionalFormActionsBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerConditionalFormActionsBundle\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "cs-fix": "./vendor/bin/php-cs-fixer fix --config .php-cs-fixer.php --using-cache no --show-progress dots -v"
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
