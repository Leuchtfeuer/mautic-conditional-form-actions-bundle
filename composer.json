{
    "name": "leuchtfeuer/mautic-conditional-form-actions-bundle",
    "description": "Enables conditional form submit actions",
    "license": "GPL-3.0",
    "type": "mautic-plugin",
    "homepage": "https://www.Leuchtfeuer.com",
    "authors": [
        {
            "name": "Leuchtfeuer Digital Marketing GmbH",
            "email": "mautic-plugins@Leuchtfeuer.com",
            "homepage": "https://Leuchtfeuer.com/mautic/",
            "role": "Developer"
        }
    ],
    "keywords": ["mautic", "plugin", "integration", "form"],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "mautic/core-lib": "^7.0",
        "ext-json": "*"
    },
    "extra": {
        "install-directory-name": "LeuchtfeuerConditionalFormActionsBundle"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.4",
        "symfony/browser-kit": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerConditionalFormActionsBundle\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MauticPlugin\\LeuchtfeuerConditionalFormActionsBundle\\Tests\\": "Tests"
        }
    },
    "scripts": {
        "fixcs": "../../bin/php-cs-fixer fix . --config ../../.php-cs-fixer.php --show-progress dots -v",
        "rector": "cd ../.. && bin/rector process --ansi --config rector.php plugins/LeuchtfeuerConditionalFormActionsBundle",
        "phpstan": "../../bin/phpstan analyse . --memory-limit=1G -c phpstan.neon",
        "phpunit": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning",
        "unit": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning --testsuite=unit",
        "functional": "cd ../.. && APP_ENV=test APP_DEBUG=0 KERNEL_CLASS=AppTestKernel bin/phpunit -d memory_limit=2G -c plugins/LeuchtfeuerConditionalFormActionsBundle/phpunit.xml --testsuite functional",
        "coverage": "../../bin/phpunit -d memory_limit=2048M --configuration phpunit.xml --fail-on-warning --coverage-text --coverage-html=Tests/Coverage",
        "test": "@phpunit",
        "dod": "bash checkDod.sh",
        "all": [
            "@rector",
            "@fixcs",
            "@phpstan",
            "@phpunit",
            "@dod"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true
        }
    }
}
